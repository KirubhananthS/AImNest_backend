APP_ENV=development
DEBUG=false
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=*

POSTGRES_DB=aimnest
POSTGRES_USER=aimnest
POSTGRES_PASSWORD=change-me-local
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://aimnest:change-me-local@localhost:5432/aimnest

JWT_SECRET_KEY=change-me-local-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536

OTP_EXPIRES_SECONDS=180
OTP_LENGTH=6
OTP_ATTEMPT_LIMIT=3

# Enforce OTP verification (is_verified) on protected endpoints. Keep false
# until OTP delivery and a resend endpoint exist.
REQUIRE_VERIFIED_USER=false

# Local LLM assistant (Ollama). Set AI_ENABLED=false to always use the
# deterministic fallback reply; set AI_PROVIDER=none for the same effect.
AI_ENABLED=true
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=30
OLLAMA_KEEP_ALIVE=5m
OLLAMA_MAX_ATTEMPTS=2
OLLAMA_RETRY_BACKOFF_SECONDS=0.25
AI_TEMPERATURE=0.3
AI_MAX_OUTPUT_TOKENS=512
AI_HISTORY_MAX_MESSAGES=10

# User-scoped assistant context (goals, tasks, workspaces).
AI_CONTEXT_ENABLED=true
AI_CONTEXT_MAX_CHARS=4000
AI_CONTEXT_MAX_GOALS=8
AI_CONTEXT_MAX_WORKSPACES=5
AI_CONTEXT_MAX_WORKSPACE_TASKS=10
AI_CONTEXT_MAX_ACTIVITY=5
