APP_ENV=development
DEBUG=false
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=*

POSTGRES_DB=aimnest
POSTGRES_USER=aimnest
POSTGRES_PASSWORD=aimnest
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://aimnest:aimnest@localhost:5432/aimnest

JWT_SECRET_KEY=change-me-in-local-env
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536

OTP_EXPIRES_SECONDS=180
OTP_LENGTH=6
OTP_ATTEMPT_LIMIT=3
